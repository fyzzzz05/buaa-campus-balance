<Window
    x:Class="CampusBalance.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="校园余额">

  <Grid x:Name="Root"
        Background="{ThemeResource AppBackgroundBrush}"
        KeyDown="Root_KeyDown">

    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
      <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="Close_Invoked" />
    </Grid.KeyboardAccelerators>

    <!-- 代码绘制图表与导航条时读取主题画刷用（XAML 响应主题切换，代码读取最新值）。 -->
    <Grid Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False">
      <Border x:Name="ProbeHover" Background="{ThemeResource HoverBrush}" />
      <Border x:Name="ProbePanel" Background="{ThemeResource PanelBrush}" />
      <Border x:Name="ProbeLine" Background="{ThemeResource LineBrush}" />
      <TextBlock x:Name="ProbeAccent" Foreground="{ThemeResource AccentBrush}" />
      <TextBlock x:Name="ProbeOnAccent" Foreground="{ThemeResource OnAccentBrush}" />
      <TextBlock x:Name="ProbeMuted" Foreground="{ThemeResource MutedBrush}" />
      <TextBlock x:Name="ProbeInk" Foreground="{ThemeResource InkBrush}" />
    </Grid>

    <!-- ===================== 登录页（public/index.html） ===================== -->
    <Grid x:Name="LoginView">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="LoginHost" MinHeight="600" Padding="24">
          <Border x:Name="LoginCard"
                  MaxWidth="440" Padding="36" CornerRadius="26"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Background="{ThemeResource PanelBrush}"
                  BorderBrush="{ThemeResource LoginLineBrush}" BorderThickness="1">
            <StackPanel>
              <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Background="{ThemeResource LoginAccentBrush}" CornerRadius="20" />
                <Viewbox Width="29" Height="29" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Data="M3,9 L12,4 L21,9 L12,14 Z"
                          Stroke="{ThemeResource OnAccentBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M6,11 L6,16 C9,18.5 15,18.5 18,16 L18,11"
                          Stroke="{ThemeResource OnAccentBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M21,9 L21,15"
                          Stroke="{ThemeResource OnAccentBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Canvas>
                </Viewbox>
              </Grid>

              <TextBlock Text="欢迎回来" FontSize="25" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Margin="0,0,0,30" />

              <StackPanel Spacing="9" Margin="0,0,0,20">
                <TextBlock Text="学号 / 工号" FontSize="14" FontWeight="SemiBold" />
                <TextBox x:Name="UserInput" Style="{StaticResource PillTextBoxStyle}"
                         PlaceholderText="请输入学号或工号" MaxLength="65" />
              </StackPanel>

              <StackPanel Spacing="9" Margin="0,0,0,20">
                <TextBlock Text="密码" FontSize="14" FontWeight="SemiBold" />
                <Grid>
                  <PasswordBox x:Name="PasswordInput" Style="{StaticResource PillPasswordBoxStyle}"
                               PlaceholderText="请输入密码" KeyDown="Password_KeyDown" />
                  <Button x:Name="RevealPassword" Style="{StaticResource GhostIconButtonStyle}"
                          Width="40" Height="40" Margin="0,0,7,0"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="Transparent" BorderThickness="0"
                          Click="RevealPassword_Click" AutomationProperties.Name="显示密码">
                    <Grid Width="20" Height="20">
                      <Viewbox x:Name="RevealEyeOpen" Width="20" Height="20">
                        <Canvas Width="20" Height="20">
                          <Ellipse Canvas.Left="1" Canvas.Top="5" Width="18" Height="10"
                                   Stroke="{ThemeResource LoginMutedBrush}" StrokeThickness="1.8" />
                          <Ellipse Canvas.Left="7" Canvas.Top="8" Width="6" Height="6"
                                   Stroke="{ThemeResource LoginMutedBrush}" StrokeThickness="1.8" />
                        </Canvas>
                      </Viewbox>
                      <Viewbox x:Name="RevealEyeClosed" Width="20" Height="20" Visibility="Collapsed">
                        <Canvas Width="20" Height="20">
                          <Ellipse Canvas.Left="1" Canvas.Top="5" Width="18" Height="10"
                                   Stroke="{ThemeResource LoginMutedBrush}" StrokeThickness="1.8" />
                          <Line X1="3" Y1="17" X2="17" Y2="3"
                                Stroke="{ThemeResource LoginMutedBrush}" StrokeThickness="1.8" />
                        </Canvas>
                      </Viewbox>
                    </Grid>
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="14" Margin="0,3,0,26">
                <CheckBox x:Name="NetworkSame" Content="校园网使用相同密码" FontSize="14" MinWidth="0" />
                <CheckBox x:Name="Remember" Content="保存密码到本机，自动重新登录" FontSize="14" MinWidth="0" />
              </StackPanel>

              <Button x:Name="LoginButton" Style="{StaticResource SolidPillButtonStyle}"
                      HorizontalAlignment="Stretch" Click="Login_Click" AutomationProperties.Name="登录">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock x:Name="LoginButtonText" Text="登录" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock x:Name="LoginArrow" Text="→" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
              </Button>

              <TextBlock x:Name="LoginError" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap"
                         Foreground="{ThemeResource LoginErrorBrush}" Visibility="Collapsed" />

              <Grid Margin="0,26,0,26" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" VerticalAlignment="Center" Fill="{ThemeResource LoginLineBrush}" />
                <TextBlock Grid.Column="1" Text="其他登录方式" FontSize="13"
                           Foreground="{ThemeResource LoginMutedBrush}" />
                <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{ThemeResource LoginLineBrush}" />
              </Grid>

              <Button x:Name="SchoolLoginButton" Style="{StaticResource PillButtonStyle}"
                      Height="50" CornerRadius="25" HorizontalAlignment="Stretch"
                      Background="Transparent" BorderBrush="{ThemeResource LoginLineBrush}"
                      Click="SchoolLogin_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="打开学校统一认证" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="↗" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- ===================== 仪表盘（public/dashboard.html） ===================== -->
    <Grid x:Name="DashboardView" Visibility="Collapsed" Padding="32,24,32,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="HeaderRow" Margin="4,0,4,16" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="校园余额" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock x:Name="Stamp" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
          <Grid>
            <Button x:Name="MeterButton" Style="{StaticResource PillButtonStyle}"
                    Click="Settings_Click" AutomationProperties.Name="电表号">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z"
                          Stroke="{ThemeResource InkBrush}" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="电表号" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border x:Name="MeterDot" Width="8" Height="8" CornerRadius="4" Margin="0,4,4,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                    Background="{ThemeResource AccentBrush}"
                    BorderBrush="{ThemeResource PanelBrush}" BorderThickness="2" />
          </Grid>
          <Button x:Name="LogoutButton" Style="{StaticResource PillButtonStyle}"
                  Content="退出" Click="Logout_Click" />
          <Button x:Name="MoreButton" Style="{StaticResource GhostIconButtonStyle}"
                  AutomationProperties.Name="更多操作" ToolTipService.ToolTip="更多操作">
            <TextBlock Text="⋯" FontSize="18" FontWeight="SemiBold" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="刷新" Click="Refresh_Click">
                  <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                  </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem Text="外观">
                  <MenuFlyoutItem Text="跟随系统" Tag="Default" Click="Theme_Click" />
                  <MenuFlyoutItem Text="浅色" Tag="Light" Click="Theme_Click" />
                  <MenuFlyoutItem Text="深色" Tag="Dark" Click="Theme_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="打开诊断日志" Click="Logs_Click" />
                <MenuFlyoutItem Text="下载更新…" Click="Updates_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" MinHeight="440"
              Background="{ThemeResource PanelBrush}"
              BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="264" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="RailPanel" Padding="14"
                  Background="{ThemeResource SideBrush}"
                  BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0"
                  CornerRadius="19,0,0,19">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid x:Name="RailHost">
                <Border x:Name="SelectionPill" Width="0" Height="0" CornerRadius="14"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{ThemeResource AccentBrush}" IsHitTestVisible="False">
                  <Border.RenderTransform>
                    <TranslateTransform />
                  </Border.RenderTransform>
                </Border>
                <StackPanel x:Name="RailItems" Spacing="8" />
              </Grid>
              <TextBlock x:Name="RailHint" Grid.Row="1" Text="按 ↑ ↓ 键切换"
                         FontSize="12" Margin="8,10,8,0"
                         Foreground="{ThemeResource MutedBrush}" />
            </Grid>
          </Border>

          <Grid x:Name="MainPanel" Grid.Column="1" Padding="28,28,32,24" RowSpacing="18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PanelHeader" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="TitleGroup" Spacing="0">
                <TextBlock x:Name="MetricTitle" Text="校园卡余额" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="HistoryNote" Text="近 14 天" FontSize="13" Margin="0,4,0,0"
                           TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
                <Button x:Name="Reauthenticate" Style="{StaticResource PillButtonStyle}"
                        Height="32" CornerRadius="16" Padding="14,0" Margin="0,10,0,0"
                        Content="重新登录" Click="Logout_Click" Visibility="Collapsed" />
              </StackPanel>

              <Grid x:Name="ChartModeSwitch" Grid.Column="1" Height="36" Padding="3"
                    CornerRadius="18" VerticalAlignment="Top"
                    Background="{ThemeResource SideBrush}"
                    BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                <Border x:Name="ChartModeThumb" Width="64" Height="30" CornerRadius="15"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{ThemeResource AccentBrush}">
                  <Border.RenderTransform>
                    <TranslateTransform />
                  </Border.RenderTransform>
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BarModeButton" Content="柱状" Style="{StaticResource SegButtonStyle}"
                          Foreground="{ThemeResource OnAccentBrush}" Click="BarMode_Click"
                          AutomationProperties.Name="柱状图" />
                  <Button x:Name="LineModeButton" Grid.Column="1" Content="折线" Style="{StaticResource SegButtonStyle}"
                          Click="LineMode_Click" AutomationProperties.Name="折线图" />
                </Grid>
              </Grid>
            </Grid>

            <Grid x:Name="ChartHost" Grid.Row="1" MinHeight="120" Background="Transparent">
              <Canvas x:Name="ChartCanvas" />
              <Canvas x:Name="ChartOverlay" IsHitTestVisible="False">
                <Border x:Name="ChartTooltip" Padding="9,5" CornerRadius="8" Visibility="Collapsed"
                        Background="{ThemeResource TooltipBrush}">
                  <TextBlock x:Name="ChartTooltipText" FontSize="12"
                             Foreground="{ThemeResource TooltipInkBrush}" />
                </Border>
              </Canvas>
              <TextBlock x:Name="EmptyChart" Text="正在查询" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{ThemeResource MutedBrush}" />
            </Grid>

            <Grid x:Name="StatsGrid" Grid.Row="2" Padding="0,16,0,0" ColumnSpacing="12"
                  BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Spacing="2">
                <TextBlock x:Name="SumLabel" Text="14 天合计" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <TextBlock x:Name="Sum" Text="—" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource NumericFont}" />
                  <TextBlock x:Name="SumUnit" Text="元" FontSize="12" FontWeight="Medium" Margin="4,0,0,4"
                             VerticalAlignment="Bottom" Foreground="{ThemeResource MutedBrush}"
                             FontFamily="{StaticResource NumericMediumFont}" Visibility="Collapsed" />
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="StatAverageBox" Grid.Column="1" Spacing="2">
                <TextBlock Text="日均" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <TextBlock x:Name="Average" Text="—" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource NumericFont}" />
                  <TextBlock x:Name="AverageUnit" Text="元" FontSize="12" FontWeight="Medium" Margin="4,0,0,4"
                             VerticalAlignment="Bottom" Foreground="{ThemeResource MutedBrush}"
                             FontFamily="{StaticResource NumericMediumFont}" Visibility="Collapsed" />
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="StatMaxBox" Grid.Column="2" Spacing="2">
                <TextBlock Text="单日最高" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <TextBlock x:Name="Maximum" Text="—" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource NumericFont}" />
                  <TextBlock x:Name="MaximumUnit" Text="元" FontSize="12" FontWeight="Medium" Margin="4,0,0,4"
                             VerticalAlignment="Bottom" Foreground="{ThemeResource MutedBrush}"
                             FontFamily="{StaticResource NumericMediumFont}" Visibility="Collapsed" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== 电表号设置（dashboard.html 的 dialog） ===================== -->
    <Grid x:Name="MeterOverlay" Visibility="Collapsed">
      <Border Background="{ThemeResource BackdropBrush}" />
      <Border x:Name="MeterCard" MaxWidth="440" Margin="16" Padding="24,24,24,20" CornerRadius="20"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{ThemeResource PanelBrush}"
              BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
        <StackPanel Spacing="16">
          <TextBlock Text="设置电表号" FontSize="18" FontWeight="SemiBold" />

          <Grid ColumnSpacing="10" Padding="12,14" CornerRadius="12"
                Background="{ThemeResource SideBrush}"
                BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Top">
              <Ellipse Stroke="{ThemeResource AccentBrush}" StrokeThickness="2" />
              <TextBlock Text="!" FontSize="11" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{ThemeResource AccentBrush}" />
            </Grid>
            <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                       Foreground="{ThemeResource MutedBrush}"
                       Text="不知道电表号？请从北航总务公众号查询自己的电表号。" />
          </Grid>

          <StackPanel Spacing="8">
            <TextBlock Text="照明电表号" FontSize="14" FontWeight="SemiBold" />
            <TextBox x:Name="LightingInput" Style="{StaticResource PillTextBoxStyle}"
                     MaxLength="30" PlaceholderText="请输入照明电表号" />
          </StackPanel>
          <StackPanel Spacing="8">
            <TextBlock Text="空调电表号" FontSize="14" FontWeight="SemiBold" />
            <TextBox x:Name="AirInput" Style="{StaticResource PillTextBoxStyle}"
                     MaxLength="30" PlaceholderText="请输入空调电表号" />
          </StackPanel>

          <StackPanel>
            <Button Style="{StaticResource TextButtonStyle}"
                    Click="ExtraSettings_Click" AutomationProperties.Name="其他设置">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="其他设置" FontSize="13" Foreground="{ThemeResource MutedBrush}" />
                <TextBlock x:Name="ExtraSettingsChevron" Text="›" FontSize="13" RenderTransformOrigin="0.5,0.5"
                           Foreground="{ThemeResource MutedBrush}">
                  <TextBlock.RenderTransform>
                    <RotateTransform />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </StackPanel>
            </Button>
            <StackPanel x:Name="ExtraSettingsPanel" Spacing="14" Margin="0,14,0,0" Visibility="Collapsed">
              <StackPanel Spacing="8">
                <TextBlock Text="宿舍名称" FontSize="14" FontWeight="SemiBold" />
                <TextBox x:Name="DormInput" Style="{StaticResource PillTextBoxStyle}"
                         MaxLength="60" PlaceholderText="如：沙河 1 号楼" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="电费历史 GitHub 用户名（可选）" FontSize="14" FontWeight="SemiBold" />
                <TextBox x:Name="HistoryOwnerInput" Style="{StaticResource PillTextBoxStyle}"
                         MaxLength="39" PlaceholderText="用于读取自己的电费监控历史" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="电表号按账号保存在本机。" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
          <TextBlock x:Name="SettingsError" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                     Foreground="{ThemeResource ErrorBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="SettingsCancel" Content="取消" Style="{StaticResource PillButtonStyle}"
                    Click="SettingsCancel_Click" />
            <Button x:Name="SettingsSave" Content="保存" Style="{StaticResource AccentPillButtonStyle}"
                    Click="SettingsSave_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
